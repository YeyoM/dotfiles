# tmux — plugin manager clones (installed via TPM, not tracked)
tmux/.config/tmux/plugins/

# zsh
zsh/.zsh_history
zsh/.zcompdump*

# nvim — lazy/packer plugin data & caches, not the config itself
nvim/.local/share/nvim/
nvim/.local/state/nvim/
nvim/.cache/nvim/

# general local/machine-specific overrides — never commit secrets
*.local
.env

# OS/editor noise
.DS_Store
*.swp
*~

# neovim — packer's auto-generated loader (regenerated by :PackerSync)
nvim/.config/nvim/plugin/packer_compiled.lua

# spicetify — regenerated by patching / recloned by install.sh, never tracked
spicetify/.config/spicetify/Backup/
spicetify/.config/spicetify/Extracted/
spicetify/.config/spicetify/Themes/
spicetify/.config/spicetify/Extensions/
spicetify/.config/spicetify/CustomApps/

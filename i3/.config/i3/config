# ============================================================================
#  i3 Window Manager Configuration
#  ============================================================================
#  This file was originally generated by i3-config-wizard(1) and has been
#  heavily customized. It is not overwritten by the wizard.
#  ============================================================================

# ----------------------------------------------------------------------------
#  Basics
# ----------------------------------------------------------------------------
set $mod Mod4

# Font for window titles (the bar font is handled by polybar)
font pango:FiraCodeNerdFont-Medium 10

# Use Mouse+$mod to drag floating windows
floating_modifier $mod


# ----------------------------------------------------------------------------
#  Autostart Applications (exec / exec_always)
# ----------------------------------------------------------------------------

# XDG autostart (via dex)
exec --no-startup-id dex --autostart --environment i3

# NetworkManager system tray
exec --no-startup-id nm-applet

# Better lockscreen (sets background with effect)
exec_always --no-startup-id betterlockscreen

# Autotiling script (alternating layout)
exec --no-startup-id ~/i3-alternating-layout/alternating_layouts.py

# Wallpaper
exec_always feh --bg-scale ~/Pictures/wallpapers/tokyo/wallpaperflare.com_wallpaper_7.jpg

# Picom compositor
exec_always picom --config ~/.config/picom/picom.conf

# Polybar (your custom bar) – this replaces the default i3bar
exec_always --no-startup-id $HOME/polybar-collection/launch.sh

# Keyboard layout (US and Latin American, toggle with Alt+Space)
exec_always setxkbmap -layout us,latam -option grp:alt_space_toggle

# xss-lock for screen locking before suspend
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -i ~/Pictures/wallpapers/tokyo/wallpaperflare.com_wallpaper_7.jpg


# ----------------------------------------------------------------------------
#  Keybindings: Launchers & Applications
# ----------------------------------------------------------------------------

# Terminal (Kitty)
bindsym $mod+Return exec kitty

# Application launcher (rofi)
bindsym $mod+d exec rofi -show drun -font "FiraCodeNerdFont-Medium 18"

# Bluetooth manager (rofi script)
bindsym $mod+b exec --no-startup-id $HOME/rofi-bluetooth/rofi-bluetooth

# Shutter screenshot tool
bindsym $mod+Shift+s exec shutter

# Power menu (logout, reboot, shutdown)
bindsym $mod+Shift+e exec $HOME/.local/bin/powermenu.sh


# ----------------------------------------------------------------------------
#  Keybindings: Workspace Switching & Moving
# ----------------------------------------------------------------------------

# Define workspace names (with icons)
set $ws1 "1:  "
set $ws2 "2:  "
set $ws3 "3:  "
set $ws4 "4:  "
set $ws5 "5:  "
set $ws6 "6: 󰙯 "
set $ws7 "7:  "
set $ws8 "8:  "
set $ws9 "9:  "
set $ws10 "10:  "

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Assign specific applications to workspaces
assign [class="Spotify"] $ws9


# ----------------------------------------------------------------------------
#  Keybindings: Focus & Movement
# ----------------------------------------------------------------------------

# Focus with $mod + h/j/k/l (like Vim)
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# Focus with arrow keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move window with $mod+Shift+h/j/k/l
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# Move with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Focus parent container
bindsym $mod+a focus parent


# ----------------------------------------------------------------------------
#  Keybindings: Layout & Window Management
# ----------------------------------------------------------------------------

# Split orientation
bindsym $mod+h split h          # horizontal
bindsym $mod+v split v          # vertical

# Toggle fullscreen
bindsym $mod+f fullscreen toggle

# Change container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Toggle focus between tiling and floating windows
bindsym $mod+space focus mode_toggle

# Kill focused window
bindsym $mod+Shift+q kill


# ----------------------------------------------------------------------------
#  Appearance: Gaps, Borders, Colors
# ----------------------------------------------------------------------------

# Gaps
gaps outer 2px
gaps inner 10px

# Eliminate title bar (pixel border only)
default_border pixel 0

# Colors
set $bg-color 	         #2e3440
set $inactive-bg-color   #4c566a
set $text-color          #eceff4
set $inactive-text-color #d8dee9
set $urgent-bg-color     #bf616a
set $wb-focused          #4c566a
set $wb-inactive         #434c5e
set $wb-urgent           #bf616a

# Window border colors
#                       border              background         text                 indicator
client.focused          $wb-inactive        $wb-focused        $text-color          $wb-focused
client.unfocused        $inactive-bg-color  $wb-inactive       $inactive-text-color $inactive-bg-color
client.focused_inactive $inactive-bg-color  $inactive-bg-color $inactive-text-color $inactive-text-color
client.urgent           $urgent-bg-color    $urgent-bg-color   $text-color          $urgent-bg-color


# ----------------------------------------------------------------------------
#  Resize Mode
# ----------------------------------------------------------------------------

mode "resize" {
    # Shrink/grow width/height with Vim keys (j, k, l, ;)
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    # Arrow keys also work
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # Exit resize mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# Enter resize mode
bindsym $mod+r mode "resize"


# ----------------------------------------------------------------------------
#  Keybindings: System Controls
# ----------------------------------------------------------------------------

# Volume (PulseAudio)
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Brightness (requires sudo for brightnessctl, adjust if needed)
bindsym XF86MonBrightnessUp exec sudo brightnessctl set +10%
bindsym XF86MonBrightnessDown exec sudo brightnessctl set 10%-

# Media player controls (playerctl)
bindsym XF86AudioPlay exec playerctl play
bindsym XF86AudioPause exec playerctl pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Lock screen (manual lock)
bindsym $mod+shift+x exec i3lock -i ~/Pictures/wallpapers/tokyo/wave.jpeg


# ----------------------------------------------------------------------------
#  Keybindings: Screenshots (maim + xclip)
# ----------------------------------------------------------------------------

# Save to file
bindsym Print exec --no-startup-id maim "/home/$USER/Pictures/Screenshots/$(date)"
bindsym $mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) "/home/$USER/Pictures/Screenshots/$(date).png"
bindsym Shift+Print exec --no-startup-id maim --select "/home/$USER/Pictures/Screenshots/$(date).png"

# Copy to clipboard
bindsym Ctrl+Print exec --no-startup-id maim | xclip -selection clipboard -t image/png
bindsym Ctrl+$mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) | xclip -selection clipboard -t image/png
bindsym Ctrl+Shift+Print exec --no-startup-id maim --select | xclip -selection clipboard -t image/png


# ----------------------------------------------------------------------------
#  Keybindings: i3 Management
# ----------------------------------------------------------------------------

# Reload config
bindsym $mod+Shift+c reload

# Restart i3 (preserves layout)
bindsym $mod+Shift+r restart

# Exit i3 (with confirmation – currently commented out)
# bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"


